# AI Resume Generator Configuration
PORT=8000
HOST=0.0.0.0

# LLM Providers (Optional - high-precision heuristic fallback active by default)
# 1. Local Ollama (Default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# 2. OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 3. Hugging Face
HUGGINGFACEHUB_API_TOKEN=

# Custom path to candidate's Ground Truth Base Resume (Optional)
# RESUME_DATA_PATH=/path/to/my_resume.json
